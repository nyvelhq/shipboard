DATABASE_URL="postgresql://shipboard:shipboard@localhost:5432/shipboard"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="change-me-to-a-long-random-string"
PORT=4000

# Comma-separated allowed frontend origins for CORS (REST + Socket.IO).
# Defaults to http://localhost:3000,http://localhost:3001 if unset — fine
# for local dev, not for a real deployment. Set this to the actual
# deployed frontend origin(s) before going anywhere near production.
# CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Attachment storage. "local" (default) writes to ./uploads on disk —
# fine for a single dev machine, not for a deployed multi-instance app.
# Set to "s3" to store attachments in S3 (or any S3-compatible endpoint).
STORAGE_DRIVER=local
# S3_BUCKET=shipboard-attachments
# S3_REGION=us-east-1
# Only needed for a self-hosted S3-compatible endpoint (e.g. MinIO for
# local testing — see docker-compose.yml). Omit for real AWS S3, which
# picks its endpoint from S3_REGION.
# S3_ENDPOINT=http://localhost:9000
# S3_FORCE_PATH_STYLE=true
# Only needed for MinIO / non-AWS endpoints without IAM. Omit on real AWS
# to use the default credential chain (IAM role, ~/.aws/credentials, etc).
# S3_ACCESS_KEY_ID=shipboard
# S3_SECRET_ACCESS_KEY=shipboard-local-dev

# Base URL of the deployed frontend, used to build the link inside invite
# emails (e.g. "${FRONTEND_URL}/invites/{token}"). Defaults to
# http://localhost:3001 if unset.
# FRONTEND_URL=http://localhost:3001

# Invite emails. "console" (default) logs the email instead of sending it
# — no external dependency, fine for local dev. Set to "smtp" to actually
# send via any SMTP server.
EMAIL_DRIVER=console
# EMAIL_FROM="Shipboard <no-reply@shipboard.local>"
# Only needed when EMAIL_DRIVER=smtp. Point this at Mailpit for local
# testing (see docker-compose.yml) or a real relay (SendGrid/SES/etc — all
# of them speak SMTP) in production.
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_SECURE=false
# Only needed if the SMTP server requires auth (Mailpit doesn't).
# SMTP_USER=
# SMTP_PASS=
